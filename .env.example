# Public Supabase settings (safe to expose in the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only. Never expose this value through NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Canonical application URL used by auth callbacks and payment providers.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required in production when more than one Next.js instance can serve traffic.
# Generate once with: openssl rand -base64 32
# Store it in your deployment secret manager, never in Git.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Payment integrations are disabled until credentials are configured.
PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=mock
BEPaid_SHOP_ID=
BEPaid_SECRET_KEY=
WEBPAY_STORE_ID=
WEBPAY_SECRET_KEY=
